[alias]
	b = branch
	ch = checkout
	c = commit
	ca = commit --amend
	s = status -sb
	alias = config --get-regexp alias
	a = add
	pho = push origin
	pl = pull
	l = log --graph --pretty=format:'%C(cyan)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(magenta)<%an>%Creset' --abbrev-commit --date=relative
	cp = cherry-pick
	i = init
	rst = reset
	ph = push
	t = ls-tree -r HEAD --name-only
	sh = stash
	lv = !git --no-pager log | nvim -
	bv = !git branch | nvim -
	nvim-diff = !nvim -c ":DiffviewOpen" -
	lazy = !lazygit
  lazy-dotfiles = !lazygit --work-tree $HOME --git-dir $HOME/.unx
  dotfiles = "!git --work-tree $HOME --git-dir $HOME/.unx"
  resolve = !nvim -p $(git diff --name-only)
  review = !nvim -p $(git diff --name-only HEAD HEAD~1)
  nvim-diff = !nvim -c ":DiffviewOpen" -
